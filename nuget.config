<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Pinned here so a build machine with no user-level NuGet sources still restores. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
